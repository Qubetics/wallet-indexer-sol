{
  "name": "qubetics_wallet_processes",
  "version": "1.0.0",
  "description": "Process for qubetics wallet sol blockchain",
  "main": "index.sol.ts",
  "scripts": {
    "compile": "tsc",
    "server": "nodemon --max-old-space-size=20480 build/index.sol.js",
    "dev": "concurrently \"npm run compile\" \"npm run server\"",
    "start": "npm run compile && node --max-old-space-size=4096 build/index.sol.js",
    "test": "tsc && node --test test/*.test.js"
  },
  "keywords": [
    "processes"
  ],
  "author": "Qubetics",
  "license": "ISC",
  "dependencies": {
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.8",
    "@types/bignumber.js": "^5.0.0",
    "@types/node": "^16.3.2",
    "@types/node-schedule": "^1.3.2",
    "@types/redis": "^2.8.31",
    "@types/sequelize": "^4.28.10",
    "axios": "^0.21.1",
    "bignumber.js": "^9.0.1",
    "concurrently": "^6.2.0",
    "dotenv": "^14.3.2",
    "firebase-admin": "^13.0.1",
    "kafkajs": "^2.2.4",
    "mysql2": "^2.3.0",
    "node-schedule": "^2.0.0",
    "node-zookeeper-client": "^1.1.3",
    "nodemon": "^2.0.12",
    "redis": "^3.1.2",
    "sequelize": "^6.6.5",
    "typescript": "^5.3.2"
  },
  "devDependencies": {
    "@types/node-zookeeper-client": "^0.2.8"
  },
  "overrides": {
    "rpc-websockets": "9.3.1"
  }
}
